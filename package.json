{
  "name": "codebase-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI-Powered Codebase Intelligence & Review Platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @codebase-ai/api run dev",
    "dev:web": "npm --workspace @codebase-ai/web run dev",
    "start": "npm --workspace @codebase-ai/web run start",
    "start:web": "npm --workspace @codebase-ai/web run start",
    "start:api": "npm --workspace @codebase-ai/api run start",
    "build": "npm run db:generate && npm --workspace @codebase-ai/api run build && npm --workspace @codebase-ai/web run build",
    "build:api": "npm run db:generate && npm --workspace @codebase-ai/api run build",
    "build:web": "npm --workspace @codebase-ai/web run build",
    "typecheck": "npm --workspace @codebase-ai/api run typecheck && npm --workspace @codebase-ai/web run typecheck",
    "test": "npm --workspace @codebase-ai/api run test && npm --workspace @codebase-ai/web run test",
    "db:generate": "npm --workspace @codebase-ai/api run db:generate",
    "db:migrate": "npm --workspace @codebase-ai/api run db:migrate",
    "db:deploy": "npm --workspace @codebase-ai/api run db:deploy",
    "db:seed": "npm --workspace @codebase-ai/api run db:seed",
    "db:studio": "npm --workspace @codebase-ai/api run db:studio"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
