# Build context for docker/api.Dockerfile and docker/web.Dockerfile. Both build
# from the repository root, so every rule here applies to both images.
#
# Without this file the entire repository is sent as context, and
# `COPY apps/api apps/api` bakes a real .env into the build stage.

# Reinstalled inside the image from the lockfile. Copying the host's tree would
# also carry native modules compiled for the wrong platform.
node_modules
**/node_modules

# Regenerated by the image build; a stale local copy is only confusing.
dist
**/dist
apps/web/.vite

# Secrets never enter a build layer. The committed templates are kept: they
# carry variable names and no values.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# History, CI configuration and editor state: no build step reads them.
.git
.gitignore
.github
.vscode
.idea

# Documentation, and deploy manifests belonging to other platforms.
docs
*.md
render.yaml
vercel.json

# Local state written by this tool's own runs.
.codebase-ai
